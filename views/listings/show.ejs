<% layout("/layouts/boilerplate") %>

  <div class="row mt-3">
    <div class="col-8 offset-3 mb-2">
      <h2>
        <%= listing.title %>
      </h2>
    </div>
    <div class="col-6 offset-3">
      <div class="card listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing image" />
        <div class="card-body">
          <p class="card-text">
            <%= listing.description %> <br />
              &#8377; <%= Number(listing.price).toLocaleString("en-IN")%> <br />
                <%= listing.location %> <br />
                  <%= listing.country %> <br />
          </p>
        </div>
      </div>
    </div>

    <div class="col-20 btns">
      <a href="/listings/<%= listing._id%>/edit" class="show-btns col-1 offset-3">Edit</a>

      <form method="POST" action="/listings/<%= listing._id%>/delete?_method=DELETE">
        <button class="show-btns col-30 offset-3 form-btn">delete</button>
      </form>
    </div>

    <div class="col-8 offset-3 mb-3">
      <hr />
      <h4>Leave a Review</h4>
      <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <input type="range" name="review[rating]" id="rating" min="1" max="5" class="form-range" />
        </div>
        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea name="review[comment]" id="comment" cols="30" rows="3" required class="form-control"></textarea>
          <div class="invalid-feedback">Please add some comments for review</div>
        </div>
        <button class="btn btn-outline-dark">submit</button>
      </form>
      <hr />

      <p><b>All Review</b></p>
      <div class="row ">
        <% for(let review of listing.reviews) { %>
          <div class="card col-5 ms-3 mb-3">
            <div class="card-body">
              <h5 class="card-title">hari</h5>
              <p class="card-text">
                <%= review.comment %>
              </p>
              <p class="card-text">
                <%= review.rating %> Stars
              </p>
              <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id%>?_method=DELETE"
                class="mb-3">
                <button class="btn btn-sm btn-dark">Delete</button>
              </form>
            </div>
          </div>
          <% } %>
      </div>
    </div>
  </div>