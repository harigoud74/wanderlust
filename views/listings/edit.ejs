<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-8 offset-2">
    <h2>Edit your route</h2>
    <form
      method="POST"
      action="/listings/<%= listing._id %>?_method=PUT"
      class="needs-validation"
      novalidate
      enctype="multipart/form-data">
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
          type="text"
          name="listing[title]"
          value="<%= listing.title %>"
          placeholder="Enter the title name"
          class="form-control"
          required />
        <div class="valid-feedback">Tittle Looks good!</div>
        <div class="invalid-feedback">please enter the vaild Tittle name!</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" class="form-control" required>
<%= listing.description %></textarea
        >
        <div class="valid-feedback">Description Looks good!</div>
        <div class="invalid-feedback">please enter the vaild Description!</div>
      </div>
      <div class="mb-3">
        <h5>original image</h5>

        <img
          src="<%= originalImageUrl %>"
          alt=""
          style="height: 200px; width: 200px" />
      </div>
      <div class="mb-3">
        <div class="mb-3">
          <label for="image" class="form-label">upload New Image</label>
          <input type="file" name="listing[image]" class="form-control" />
          <div class="valid-feedback">image Looks Good!</div>
          <div class="invalid-feedback">please enter the vaild image URL!</div>
        </div>
      </div>
      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price</label>
          <input
            type="number"
            name="listing[price]"
            value="<%= listing.price%>"
            class="form-control"
            required />
          <div class="valid-feedback">Price Looks Good!</div>
          <div class="invalid-feedback">please enter the vaild price!</div>
        </div>
        <div class="mb-3 col-md-8">
          <label for="country" class="form-label">country</label>
          <input
            type="text"
            name="listing[country]"
            value="<%= listing.country%>"
            class="form-control"
            required />
          <div class="valid-feedback">Counrty Looks Good!</div>
          <div class="invalid-feedback">
            please enter the vaild Counrty Name!
          </div>
        </div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input
          type="text"
          name="listing[location]"
          value="<%= listing.location %>"
          class="form-control"
          required />
        <div class="valid-feedback">Location Looks Good!</div>
        <div class="invalid-feedback">please enter the vaild Location!</div>
      </div>

      <button class="btn btn-dark add-btn">Edit</button>
    </form>
  </div>
</div>
